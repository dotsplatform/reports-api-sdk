{
    "name": "dotsplatform/reports-api-sdk",
    "description": "Library for the Dots Platform reports service client",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Dotsplatform\\ReportsApi\\": "src/App"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dotsplatform\\ReportsApi\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Bogdan Mamontov",
            "email": "bohdan.mamontov@dotsplatform.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "dotsplatform/utils": "^2.3"
    },
    "require-dev": {
        "eduarguz/shift-php-cs": "^3.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "scripts": {
        "init-pre-commit": [
            "cp .git-hooks-pre-commit .git/hooks/pre-commit"
        ],
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=2G",
        "fix": "vendor/bin/php-cs-fixer fix",
        "fix-check": "vendor/bin/php-cs-fixer fix --dry-run --diff"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dotsplatform\\ReportsApi\\ReportsApiServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
